# PostgreSQL Database Configuration
POSTGRES_DB=ewaste
POSTGRES_USER=ewaste
# Generate on EC2 using: openssl rand -base64 18 | tr -dc 'a-zA-Z0-9'
POSTGRES_PASSWORD=your_secure_db_password_here

# JWT Signing Secret (must be at least 32 characters, preferably 64+)
# Generate on EC2 using: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here

# Admin account (admin@ewaste.app). Set this to a strong password you keep private.
# On every start the admin's password is set to this value, so changing it here and restarting rotates it.
# If left empty AND SEED_DEMO=true, the demo password Admin@123 is used. Never leave it empty on a public server.
ADMIN_PASSWORD=

# Application Configuration
SEED_DEMO=true
